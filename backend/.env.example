# Copy to .env and fill in ONE of these to enable LLM-powered generation.
# Without a key, Groundwork runs its offline extractive engine — see README.
# If both are set, Gemini is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=3000
DATA_DIR=./data
